│   │   ├── clearances.py        # Clearance system
│   │   └── phraseology.py       # Standard ATC communications
│   ├── rendering/
│   │   ├── renderer.py          # Pygame rendering engine
│   │   ├── camera.py            # Pan/zoom controls
│   │   └── ui.py                # UI elements
│   └── utils/
│       ├── coordinates.py       # Lat/lon transformations
│       └── geojson_parser.py    # Parse airport GeoJSON
├── data/
│   └── airports/
